      { "label": "K-Means Objective", "formula": "Min Σᵢ Σₓ∈Cᵢ ||x - μᵢ||²", "note": "Minimize WCSS" },
      { "label": "Silhouette Score", "formula": "s = (b-a)/max(a,b)", "note": "-1 to 1; higher = better" },
      { "label": "DBSCAN Core Point", "formula": "|N_ε(p)| ≥ MinPts", "note": "ε-neighborhood has MinPts points" },
      { "label": "Elbow Method", "formula": "Plot k vs WCSS", "note": "Pick elbow (diminishing returns)" },
      { "label": "Centroid Update", "formula": "μᵢ = (1/|Cᵢ|) Σₓ∈Cᵢ x", "note": "Mean of cluster points" }
