      { "label": "Bayes Theorem", "formula": "P(C|X) = P(X|C)·P(C) / P(X)", "note": "Posterior = Likelihood × Prior / Evidence" },
      { "label": "Naive Assumption", "formula": "P(X|C) = ΠP(xᵢ|C)", "note": "Features are independent given class" },
      { "label": "MAP Decision", "formula": "ĉ = argmax P(C)·ΠP(xᵢ|C)", "note": "Maximum A Posteriori" },
      { "label": "Laplace Smoothing", "formula": "P(xᵢ|C) = (count+α)/(N+α·|V|)", "note": "Handles zero probabilities" },
