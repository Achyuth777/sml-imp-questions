      { "label": "OLS Loss", "formula": "L = Σ(yᵢ - ŷᵢ)²", "note": "Minimize sum of squared residuals" },
      { "label": "Ridge (L2)", "formula": "L = RSS + λΣβⱼ²", "note": "Coefficients → 0 but never 0" },
      { "label": "Lasso (L1)", "formula": "L = RSS + λΣ|βⱼ|", "note": "Coefficients can = 0 (feature selection)" },
      { "label": "Elastic Net", "formula": "L = RSS + λ₁Σ|βⱼ| + λ₂Σβⱼ²", "note": "Combines L1 and L2" },
      { "label": "R² Score", "formula": "R² = 1 - SS_res/SS_tot", "note": "1 = perfect fit, 0 = no fit" },
      { "label": "Bias-Variance", "formula": "Error = Bias² + Variance + Noise", "note": "Tradeoff central to ML" }
    ]
  },
  {
    "id": "cs2",
    "title": "SVM Key Concepts",
    "unit": "Unit 2",
    "color": "#8b5cf6",
    "icon": "⚡",
    "items": [
      { "label": "Decision Boundary", "formula": "w·x + b = 0", "note": "Separating hyperplane" },
      { "label": "Margin", "formula": "M = 2/||w||", "note": "Maximize this" },
      { "label": "SVM Objective", "formula": "Min ½||w||² s.t. yᵢ(w·xᵢ+b) ≥ 1", "note": "Constrained optimization" },
      { "label": "RBF Kernel", "formula": "K(x,z) = exp(-γ||x-z||²)", "note": "Most popular kernel" },
      { "label": "Polynomial Kernel", "formula": "K(x,z) = (x·z + c)^d", "note": "Degree d polynomial" },
      { "label": "Hyperplane Dim", "formula": "dim = n_features - 1", "note": "2 features → line, 3 → plane" }
    ]
  },
