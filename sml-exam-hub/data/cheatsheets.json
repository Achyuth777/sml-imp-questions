      { "label": "SVD", "formula": "A = UΣVᵀ", "note": "U, V orthogonal; Σ diagonal" },
      { "label": "Covariance Matrix", "formula": "C = (1/n-1) XᵀX", "note": "After mean centering" },
      { "label": "PCA Transform", "formula": "X_pca = X × W", "note": "W = eigenvectors matrix" },
      { "label": "Eigen Equation", "formula": "C·v = λ·v", "note": "Find eigenvectors v, eigenvalues λ" },
      { "label": "Explained Variance", "formula": "ratio = λᵢ / Σλⱼ", "note": "% variance per component" },
      { "label": "Matrix Rank", "formula": "rank(A) = #non-zero σ in Σ", "note": "From SVD" }
    ]
